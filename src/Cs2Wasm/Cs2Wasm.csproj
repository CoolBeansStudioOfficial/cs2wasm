<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cs2Wasm</RootNamespace>
    <NoWarn>$(NoWarn);RS1024;RS2008;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Upstream/**" />
    <Compile Remove="Godot/**" />
    <EmbeddedResource Include="Godot/*.cs" LogicalName="godot/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Upstream/**/*.cs;Upstream/**/manifest.txt" LogicalName="upstream/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
