<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cs2Wasm</RootNamespace>
    <NoWarn>$(NoWarn);RS1024;RS2008;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Lib/**" />
    <EmbeddedResource Include="Lib/**/*.cs" LogicalName="lib/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
