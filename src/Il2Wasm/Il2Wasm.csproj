<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Il2Wasm</RootNamespace>
    <!-- Not "Il2Wasm": the command line's assembly is il2wasm, and the two sit in one directory on file systems that
         ignore case. -->
    <AssemblyName>Il2Wasm.Compiler</AssemblyName>
    <NoWarn>$(NoWarn);RS1024;RS2008;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Upstream/**" />
    <Compile Remove="Godot/**" />
    <!-- the IL front end is its own project (IL/Il2Wasm.IL.csproj) while the operation-tree front end is here -->
    <Compile Remove="IL/**" />
    <EmbeddedResource Remove="IL/**" />
    <None Remove="IL/**" />
    <InternalsVisibleTo Include="Il2Wasm.IL" />
    <InternalsVisibleTo Include="Il2Wasm.IL.Tests" />
    <EmbeddedResource Include="Godot/*.cs" LogicalName="godot/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Upstream/**/*.cs;Upstream/**/manifest.txt" LogicalName="upstream/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
